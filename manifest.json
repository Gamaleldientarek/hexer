{
  "manifest_version": 3,
  "name": "Hexer — Website Color Palette from CSS",
  "version": "1.0.2",
  "description": "Get the exact color palette of any website, straight from its CSS.",
  "homepage_url": "https://gamaleldien.com",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hexer — grab this site's palette",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
